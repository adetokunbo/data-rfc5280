cabal-version:      3.0
name:               x509-extensions
version:            0.1.0.0
synopsis:           Types that represent the standard X509 extensions
description:
  @x509-extensions@ provides Haskell types for the standard X.509v3
  certificate extensions defined in RFC 5280, together with a renderer that
  serialises each extension value to OpenSSL configuration format.
  .
  The library is encode-only: it produces @ByteString@ output suitable for use
  with OpenSSL config files, but does not parse or decode existing certificate
  data.
  .
  Extensions covered include @BasicConstraints@, @KeyUsage@,
  @ExtendedKeyUsage@, @SubjectAltName@, @IssuerAltName@,
  @AuthorityKeyIdentifier@, @SubjectKeyIdentifier@, @CertificatePolicies@,
  @PolicyMappings@, @NameConstraints@, @CRLDistributionPoints@,
  @AuthorityInfoAccess@, and @InhibitAnyPolicy@.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Tim Emiola
maintainer:         adetokunbo@emio.la
category:           Web
homepage:           https://github.com/adetokunbo/x509-extensions#readme
bug-reports:
  https://github.com/adetokunbo/x509-extensions/issues
tested-with:        GHC ==8.10.7 || ==9.0.2 || ==9.2.8 || ==9.4.8 || ==9.6.6 || ==9.8.4
build-type:         Simple
extra-source-files:
  ChangeLog.md

source-repository head
  type:     git
  location: https://github.com/adetokunbo/x509-extensions.git

library
  exposed-modules:
    Data.X509.XT
    Data.X509.XT.AuthorityInfoAccess
    Data.X509.XT.AuthorityKeyIdentifier
    Data.X509.XT.BasicConstraints
    Data.X509.XT.CertificatePolicies
    Data.X509.XT.CRLDistributionPoints
    Data.X509.XT.ExtKeyUsage
    Data.X509.XT.GeneralName
    Data.X509.XT.HasOID
    Data.X509.XT.InhibitAnyPolicy
    Data.X509.XT.IssuerAltName
    Data.X509.XT.PolicyMappings
    Data.X509.XT.KeyUsage
    Data.X509.XT.NameConstraints
    Data.X509.XT.SubjectAltName
    Data.X509.XT.SubjectKeyIdentifier
  other-modules:
    Data.X509.XT.Internal
  hs-source-dirs:   src
  build-depends:
    , base                 >=4.10 && <5
    , bytestring           >=0.10.8.2 && <0.11 || >=0.11.3.1 && <0.13
    , email-validate       >=2.3 && <2.4
    , ip                   >=1.3 && <1.9
    , modern-uri           >=0.3 && <0.4
    , nonempty-containers  >=0.3 && <0.4
    , text                 >=1.2 && <2.2

  default-language: Haskell2010
  ghc-options:      -Wall -Wincomplete-uni-patterns -Wpartial-fields -fwarn-tabs

test-suite test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  other-modules:
    X509.ExtensionSpec
    X509.Extension.AuthorityInfoAccessSpec
    X509.Extension.CRLDistributionPointsSpec
    X509.Extension.Fixtures
    X509.Extension.GeneralNameSpec
    X509.Extension.Generators
    X509.Extension.HasOIDSpec
    X509.Extension.InhibitAnyPolicySpec
    X509.Extension.IssuerAltNameSpec
    X509.Extension.NameConstraintsSpec
    X509.Extension.PolicyMappingsSpec
    X509.Extension.SubjectAltNameSpec
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -Wall -fwarn-tabs
  build-depends:
    , base
    , bytestring
    , email-validate  >=2.3 && <2.4
    , hspec           >=2.7 && < 2.12
    , ip              >=1.3 && <1.9
    , modern-uri      >=0.3 && <0.4
    , QuickCheck      >=2.13 && < 2.16
    , text            >=1.2 && <2.2
    , x509-extensions

