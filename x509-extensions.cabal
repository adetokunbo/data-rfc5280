cabal-version:      3.0
name:               x509-extensions
version:            0.1.0.0
synopsis:           Types that represent the standard X509 extensions
description:
  Provides types that represent the contents of the standard X509 extensions

license:            BSD-3-Clause
license-file:       LICENSE
author:             Tim Emiola
maintainer:         adetokunbo@emio.la
category:           Web
homepage:           https://github.com/adetokunbo/x509-extensions#readme
bug-reports:
  https://github.com/adetokunbo/x509-extensions/issues
tested-with:        GHC ==8.10.7 || ==9.0.2 || ==9.2.8 || ==9.4.8 || ==9.6.6 || ==9.8.4
build-type:         Simple
extra-source-files:
  ChangeLog.md

source-repository head
  type:     git
  location: https://github.com/adetokunbo/x509-extensions.git

library
  exposed-modules:
    DataType.X509.Extension
    DataType.X509.Extension.AuthorityInfoAccess
    DataType.X509.Extension.AuthorityKeyIdentifier
    DataType.X509.Extension.BasicConstraints
    DataType.X509.Extension.CertificatePolicies
    DataType.X509.Extension.CRLDistributionPoints
    DataType.X509.Extension.ExtKeyUsage
    DataType.X509.Extension.GeneralName
    DataType.X509.Extension.HasOID
    DataType.X509.Extension.InhibitAnyPolicy
    DataType.X509.Extension.IssuerAltName
    DataType.X509.Extension.PolicyMappings
    DataType.X509.Extension.KeyUsage
    DataType.X509.Extension.NameConstraints
    DataType.X509.Extension.SubjectAltName
    DataType.X509.Extension.SubjectKeyIdentifier
  other-modules:
    DataType.X509.Extension.Internal
  hs-source-dirs:   src
  build-depends:
    , base                 >=4.10 && <5
    , bytestring           >=0.10.8.2 && <0.11 || >=0.11.3.1 && <0.13
    , chunked-data         >=0.3.0 && <0.4
    , email-validate       >=2.3 && <2.4
    , ip                   >=1.3 && <1.9
    , modern-uri           >=0.3 && <0.4
    , nonempty-containers  >=0.3 && <0.4
    , text                 >=1.2 && <2.2

  default-language: Haskell2010
  ghc-options:      -Wall -Wincomplete-uni-patterns -Wpartial-fields -fwarn-tabs

test-suite test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  other-modules:
    X509.ExtensionSpec
    X509.Extension.AuthorityInfoAccessSpec
    X509.Extension.CRLDistributionPointsSpec
    X509.Extension.GeneralNameSpec
    X509.Extension.Generators
    X509.Extension.HasOIDSpec
    X509.Extension.InhibitAnyPolicySpec
    X509.Extension.IssuerAltNameSpec
    X509.Extension.NameConstraintsSpec
    X509.Extension.PolicyMappingsSpec
    X509.Extension.SubjectAltNameSpec
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -Wall -fwarn-tabs
  build-depends:
    , base
    , bytestring
    , email-validate  >=2.3 && <2.4
    , hspec           >=2.7 && < 2.12
    , ip              >=1.3 && <1.9
    , modern-uri      >=0.3 && <0.4
    , QuickCheck      >=2.13 && < 2.16
    , text            >=1.2 && <2.2
    , x509-extensions

